Output demo/demo-ja.gif

Set Shell "bash"
Set FontFamily "Noto Sans Mono CJK JP"
Set FontSize 15
Set Width 1440
Set Height 860
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Hide
Type `export PATH="$DEMO_BIN:$PATH" XDG_CONFIG_HOME="$DEMO_HOME/config" XDG_CACHE_HOME="$DEMO_HOME/cache" PS1="$ "; cd "$DEMO_REPO"; clear`
Enter
Sleep 500ms
Show

Sleep 800ms
Type "tour"
Sleep 400ms
Enter
Sleep 2.5s
Enter
Sleep 2.5s
Right
Sleep 2.5s
Right
Sleep 3s
Right
Sleep 250ms
Right
Sleep 3s
Right
Sleep 250ms
Right
Sleep 3s
Right
Sleep 3.5s
Right
Sleep 250ms
Right
Sleep 3.5s
Right
Sleep 4.5s
Right
Sleep 4s
Sleep 500ms
Type "q"
Sleep 1s
