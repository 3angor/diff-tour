                  {
                    "line": 27,
                    "text": "过期：expiresAt <= 现在"
                  },
                  {
                    "line": 28,
                    "text": "先消耗 1 次，失败就是用完"
                  },
                  {
                    "line": 32,
                    "text": "折扣不超过订单总额"
                  }
