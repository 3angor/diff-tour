          "blocks": [
            {
              "snippet": {
                "label": "修正方案示意（不是这个仓库里的代码）",
                "lang": "typescript",
                "text": "// apply 中，状态检查之后\nif (order.couponCode === code) return order; // 同一张券重复提交：不再消耗\nif (order.couponCode !== undefined) {\n  throw new CouponAlreadyAppliedError(order.couponCode); // 换券：先拒绝\n}\n// 之后的 consumeUse 和 orders.save 放进同一个事务（BEGIN … COMMIT）"
