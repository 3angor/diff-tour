                  [
                    "先 A 后 B",
                    "409，A 的次数仍是 1，但没有白耗 ✔"
                  ],
                  [
                    "consumeUse 成功后 save 抛错",
                    "事务回滚，次数不丢 ✔（需要事务）"
                  ],
                  [
                    "用了券但一直不结账",
                    "仍然占着名额 ✘"
                  ]
                ]
